{
  "name": "impaktrix",
  "displayName": "IMPAKTRIX",
  "description": "See the impact before the change. Universal code impact analysis.",
  "version": "1.0.0",
  "publisher": "your-name-or-org",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "impaktrix-explorer",
          "title": "IMPAKTRIX",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "impaktrix-explorer": [
        {
          "id": "impaktrix-impact-panel",
          "name": "Impact Analysis",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "impaktrix.analyze",
        "title": "IMPAKTRIX: Analyze Impact"
      }
    ],
    "configuration": {
      "title": "IMPAKTRIX",
      "properties": {
        "impaktrix.aiEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-powered impact explanations."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm-run-all --parallel build:*",
    "watch": "npm-run-all --parallel watch:*",
    "package": "npm-run-all --parallel build:*",
    "build:extension": "esbuild ./src/extension/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "build:mcp": "esbuild ./src/mcp/server.ts --bundle --outfile=out/mcp.js --platform=node --format=cjs",
    "build:webview": "vite build",
    "watch:extension": "npm run build:extension -- --watch",
    "watch:webview": "vite build --watch"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/vscode": "^1.80.0",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^1.34.0",
    "ts-morph": "^28.0.0"
  }
}
